 "phases": [
  {
   "finding": "Yes. The key-value positive control moves 38 points between edge and middle slots, and the four QA calibration conditions order as designed.",
   "id": "phase1",
   "name": "Calibration",
   "question": "Can the harness detect a position effect that is known to exist?",
   "status": "instrument check"
  },
  {
   "finding": "Pythia carries a +5.19 point primacy edge; both Mamba variants sit at or below zero. Both paired differences clear Holm correction at p < 0.0001.",
   "id": "phase2",
   "name": "Matched 2.8B architectures",
   "question": "Do attention and state-space mixers use the same evidence differently?",
   "status": "primary result"
  },
  {
   "finding": "The hybrid has a significant within-model primacy edge and the pure model does not, but the paired difference is +1.88 points with Holm p = 0.1442.",
   "id": "phase3",
   "name": "Pure vs hybrid at 8B",
   "question": "Does adding attention blocks to a state-space model create primacy?",
   "status": "suggestive, not significant"
  },
  {
   "finding": "No. It is near zero at the two smallest pairs and appears from 790M vs 1B onward. Capability and architecture remain confounded.",
   "id": "phase4",
   "name": "Scale sweep",
   "question": "Is the family gap present at every model size?",
   "status": "scale-emergent"
  },
  {
   "finding": "No. Pile vs SlimPajama moves the level of the curve by 16 points but the primacy interaction is -0.69 points with Holm p = 0.568.",
   "id": "phase5",
   "name": "Pretraining corpus",
   "question": "Does swapping the pretraining corpus reproduce the effect?",
   "status": "null shape change"
  },
  {
   "finding": "Partly. Pythia reproduces a +12 point primacy edge on RULER at 2K tokens; both Mamba models saturate at 1.0 and cannot be compared there.",
   "id": "phase6",
   "name": "Synthetic retrieval",
   "question": "Does the effect transfer off multi-document QA?",
   "status": "one arm only"
  },
  {
   "finding": "Late-layer attention-sink mass tracks primacy across Pythia scale, and position stays linearly decodable in both families, favouring a utilisation gap over a storage gap.",
   "id": "phase7",
   "name": "Mechanisms",
   "question": "What distinguishes the two families internally?",
   "status": "correlational"
  },
  {
   "finding": "All three show positive primacy edges, but their many differences make this a prevalence description rather than an architecture test.",
   "id": "phase8",
   "name": "Production systems",
   "question": "Do deployed 7-8B systems show the same shape?",
   "status": "descriptive"
  }
